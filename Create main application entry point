from fastapi import FastAPI
from bot import BotEngine

app = FastAPI(
    title="ConvoForge",
    version="0.1.0"
)

bot = BotEngine()


@app.get("/")
def home():
    return {
        "project": "ConvoForge",
        "status": "Running"
    }


@app.get("/message")
def message():
    return bot.process_message(
        platform="Telegram",
        user_id="12345",
        message="Hello"
    )
